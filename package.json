{
  "name": "enterprise-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others -n api,worker,web,api-ts,worker-ts \"npm run dev -w @zhiheng/api\" \"npm run dev -w @zhiheng/worker\" \"npm run dev -w @zhiheng/web\" \"npm run watch -w @zhiheng/api\" \"npm run watch -w @zhiheng/worker\"",
    "build:packages": "npm run build -w @zhiheng/contracts && npm run build -w @zhiheng/config && npm run build -w @zhiheng/chunker && npm run build -w @zhiheng/resources && npm run build -w @zhiheng/parser",
    "build": "npm run build:packages && npm run build --workspaces --if-present --include-workspace-root=false",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "smoke:queue": "npm run smoke -w @zhiheng/worker",
    "test:auth": "node --test scripts/auth.integration.mjs",
    "db:migrate": "npm run migrate -w @zhiheng/resources",
    "db:seed:dev": "npm run seed:dev -w @zhiheng/resources",
    "test:resources": "node --env-file-if-exists=.env --test scripts/resources.integration.mjs",
    "storage:init": "npm run storage:init -w @zhiheng/resources",
    "uploads:cleanup": "npm run uploads:cleanup -w @zhiheng/resources --",
    "test:uploads": "node --env-file-if-exists=.env --test scripts/uploads.integration.mjs",
    "storage:dev": "moto_server -H 127.0.0.1 -p 9000",
    "test:ingestion": "node --env-file-if-exists=.env --test scripts/ingestion.integration.mjs",
    "test:parsing": "node --env-file-if-exists=.env --test scripts/parsing.integration.mjs",
    "test:chunking": "node --env-file-if-exists=.env --test scripts/chunking.integration.mjs",
    "compare:chunks": "node scripts/compare-chunks.mjs",
    "test:indexing": "node --env-file-if-exists=.env --test scripts/indexing.integration.mjs",
    "validate:embedding": "node --env-file-if-exists=.env scripts/validate-local-embedding.mjs",
    "test:retrieval": "node --env-file-if-exists=.env --test scripts/retrieval.integration.mjs",
    "index:warm": "node --env-file-if-exists=.env scripts/warm-index.mjs",
    "test:answers": "node --env-file-if-exists=.env --test scripts/answers.integration.mjs",
    "test:chat": "node --env-file-if-exists=.env --test scripts/chat.integration.mjs",
    "eval:baseline": "node --env-file-if-exists=.env scripts/evaluation/run.mjs",
    "eval:fixture": "node --env-file-if-exists=.env scripts/evaluation/run.mjs --fixture --probes",
    "eval:review": "node scripts/evaluation/review.mjs",
    "test:evaluation": "node --env-file-if-exists=.env --test scripts/evaluation.integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3"
  }
}
