# Development only. Copy to .env; never commit actual credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set REDIS_PASSWORD when connecting to a protected external Redis.
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=knowledge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledge:local-development-only@127.0.0.1:5432/knowledge
# S3-compatible private bucket with versioning enabled. Never expose credentials to VITE_*.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=knowledge-dev
S3_ACCESS_KEY_ID=local-development
S3_SECRET_ACCESS_KEY=local-development-only

# P1-02: disabled by default. Generate a private random secret before enabling.
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
AUTH_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_SECONDS=28800
AUTH_REDIS_PREFIX=zhiheng:auth:
# Comma-separated fixture accounts to disable: employee,other
DEV_DISABLED_ACCOUNTS=

# Resource truth source. Apply migrations and explicit development seed before login.
DATABASE_SCHEMA=public
# At least 32 random characters. In development/test, falls back to DEV_AUTH_SECRET.
RESOURCE_CURSOR_SECRET=

UPLOAD_MAX_BYTES=10485760
UPLOAD_TENANT_BYTES=1073741824
UPLOAD_ACTIVE_TICKETS=20
UPLOAD_TTL_SECONDS=600

# Durable ingestion and P1-06 structure parsing.
INGEST_ENABLED=true
INGEST_QUEUE=knowledge-ingestion
INGEST_MAX_ATTEMPTS=3
INGEST_LEASE_MS=15000
INGEST_DEADLINE_MS=120000
INGEST_RETRY_MS=1000
INGEST_RECONCILE_MS=10000
INGEST_POLL_MS=1000

# Disable only to pause at awaiting_parser; enabling resumes those dependency jobs.
PARSER_ENABLED=true
PARSER_MAX_BYTES=10485760
PARSER_MAX_CHARACTERS=1000000
PARSER_MAX_BLOCKS=10000
PARSER_MAX_PAGES=200
PARSER_MAX_OUTPUT_BYTES=5242880
PARSER_TIMEOUT_MS=30000
PARSER_HEAP_MB=256
PARSER_MAX_ZIP_BYTES=20971520
PARSER_MAX_ZIP_ENTRIES=1000

# P1-07: resume eligible parsed versions; false pauses at awaiting_chunker.
# Chunking parameters are frozen in structure-chunks-v1, not runtime overrides.
CHUNKER_ENABLED=true

# P1-08: local CPU embeddings. Keep disabled until model + Milvus are configured.
INDEX_ENABLED=false
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_MODEL=bge-small-zh-v1.5
# SHA-256 revision reported by the local runner /metadata; do not use mutable main.
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=512
EMBEDDING_PROCESSING=cls-token-windows-mean-l2-v1
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_ALLOW_REMOTE=false
EMBEDDING_API_KEY=
# Optional supplier token price; blank means unknown, not zero total running cost.
EMBEDDING_COST_PER_MILLION=
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_TIMEOUT_MS=10000
MILVUS_TOKEN=

# P1-10: a separately hosted local OpenAI-compatible generation service.
# Set model + immutable weights/deployment revision before enabling. No auto-download.
GENERATION_ENABLED=false
GENERATION_BASE_URL=http://127.0.0.1:8082/v1
GENERATION_MODEL=
GENERATION_REVISION=
GENERATION_TIMEOUT_MS=45000
GENERATION_API_KEY=

# Lifecycle: development defaults; approve your organization's retention policy before enabling physical erasure.
# Upgrade all writers and drain legacy API/worker requests before enabling cleanup.
LIFECYCLE_CLEANUP_ENABLED=false
LIFECYCLE_DELETE_RETENTION_HOURS=168
CHAT_HISTORY_RETENTION_DAYS=30
LIFECYCLE_POLL_MS=1000

# Optional loopback reranker. Disabled until a pinned local model service is deployed.
RERANK_ENABLED=false
RERANK_BASE_URL=http://127.0.0.1:8083/v1
RERANK_MODEL=bge-reranker-v2-m3
RERANK_REVISION=
RERANK_TIMEOUT_MS=2000
