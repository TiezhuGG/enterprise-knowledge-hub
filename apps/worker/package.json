{
  "name": "@zhiheng/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "smoke": "node --env-file-if-exists=../../.env dist/smoke.js"
  },
  "dependencies": {
    "@nestjs/core": "^11.1.0",
    "@nestjs/common": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@zhiheng/contracts": "0.1.0",
    "@zhiheng/config": "0.1.0",
    "bullmq": "^5.0.0",
    "@zhiheng/resources": "0.1.0"
  }
}
